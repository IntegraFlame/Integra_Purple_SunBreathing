{
  "python.defaultInterpreterPath": "${workspaceFolder}/integra-homebase/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "liveServer.settings.port": 5500,
  "liveServer.settings.proxy": {
    "enable": true,
    "baseUri": "/clock",
    "proxyUri": "http://127.0.0.1:8000/clock"
  },
  "liveServer.settings.Cors": {
    "enable": true,
    "allowOrigin": "*",
    "allowMethods": "*",
    "allowHeaders": "*"
  }
}
